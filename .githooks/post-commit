#!/bin/sh
# Refresh codanna index after every commit.
# Incremental (`codanna index`) currently no-ops silently even when
# files have changed on disk (2026-07-15) — use -f for a reliable
# rebuild. Runs in the background so `git commit` returns immediately.
# Log to /tmp so a failed rebuild is inspectable but doesn't spam
# terminal output.

command -v codanna >/dev/null 2>&1 || exit 0

REPO="$(git rev-parse --show-toplevel)"
LOG="/tmp/codanna-reindex-$(basename "$REPO").log"

nohup codanna index -f "$REPO" >"$LOG" 2>&1 &
