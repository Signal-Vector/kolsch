#!/bin/sh
# Refresh codanna index after a branch switch. Git passes three args
# to post-checkout: $1=prev_head $2=new_head $3=branch_flag (1=branch,
# 0=file). Only fire on branch switches; skip file-checkouts to avoid
# a full rebuild for every `git checkout -- <path>`.

[ "$3" = "1" ] || exit 0
command -v codanna >/dev/null 2>&1 || exit 0

REPO="$(git rev-parse --show-toplevel)"
LOG="/tmp/codanna-reindex-$(basename "$REPO").log"

nohup codanna index -f "$REPO" >"$LOG" 2>&1 &
