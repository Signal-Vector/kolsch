# Claude Code local state — permission allowlists, scheduled-task
# locks, worktree bookkeeping. All machine-local, never shared.
.claude/

# Codanna already lives in .codannaignore; index data is local.
# Keep `.codannaignore` itself tracked — it's the project's index policy.
.codanna/
.fastembed_cache

# Local-only project planning artifacts. Specs / bug writeups / QoL
# tickets / phase plans live here as a working knowledge base. The
# public docs site (docs/) pulls migrated, polished versions of
# whatever the team decides is enduring architectural content; the
# raw process notes stay local.
#
# Anchored to root so it doesn't also match `docs/process/` (which
# holds the contributor process pages that DO ship).
/process/

# MkDocs build output
site/

# pi-subagents run artifacts
.pi-subagents/
