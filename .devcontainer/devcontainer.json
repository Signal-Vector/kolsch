{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Agent Platform (dev)",
  "dockerComposeFile": ["../compose.dev.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "containerEnv": {
    "KOLSCH_WORKSPACE": "/workspace"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "[python]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          },
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "ruff.path": ["/opt/venv/bin/ruff"],
        "mypy-type-checker.path": ["/opt/venv/bin/mypy"],
        "mypy-type-checker.args": ["--config-file=pyproject.toml"]
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"
      ]
    }
  },
  "postCreateCommand": "uv sync --frozen --all-groups && uv run pre-commit install"
}
