# Keep the container build context lean. The Containerfile copies
# pyproject.toml, uv.lock, README.md, src/, tests/, docs/, AGENTS.md
# (docs/ and AGENTS.md are force-included by hatchling as package
# data), examples/ (the tutorial example bundle the tests load) and
# scripts/ (commit-gate helpers); everything else is noise that slows
# builds and confuses caching.

.git/
.github/
.codanna/
.codannaignore
.fastembed_cache/
.devcontainer/
.vscode/
.idea/
.pre-commit-config.yaml

# Build outputs and venvs (don't ship the host venv into the image)
.venv/
venv/
build/
dist/
*.egg-info/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Platform runtime artifacts
.platform/
sessions/
content/
logs/
*.db
*.db-journal

# Secrets — never bake into images
.env
.env.*

# Compose files (Containerfile doesn't reference them). docs/ and
# AGENTS.md must stay in the context — they are force-included by
# pyproject's hatch wheel target, and the editable install evaluates
# force-include just like the wheel build does.
compose.dev.yml
compose.test.yml

# OS noise
.DS_Store
